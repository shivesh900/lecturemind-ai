# ---------------------------------------------------------------------------
# LectureMind AI configuration. Copy to `.env` (project root) and fill in.
# NEVER commit your real .env. Secrets stay on the server and are never sent
# to the browser.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development            # development | production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- MongoDB (local or Atlas) ---
MONGODB_URI=mongodb://localhost:27017
# Atlas example: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lecturemind

# --- Auth (use a long random string in production: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=10080
COOKIE_SECURE=false                # true when served over HTTPS
COOKIE_SAMESITE=lax                # lax | strict | none (none requires COOKIE_SECURE=true)

# --- OpenAI (summaries, notes, quizzes, flashcards, knowledge map, chat, embeddings) ---
# Leave empty to run in clearly-labelled DEMO MODE (local transcription + non-LLM extraction).
# When set, lecture TRANSCRIPTS are sent to OpenAI to generate study material.
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # optional: any OpenAI-compatible endpoint
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=4
LLM_MAX_OUTPUT_TOKENS=4000
CHUNK_TARGET_CHARS=3500            # ~900 tokens per transcript chunk (map step)

# --- Transcription ---
# local  = faster-whisper on this server (free, private, default without a key)
# openai = OpenAI Whisper API (AUDIO is sent to OpenAI)
# auto   = openai if OPENAI_API_KEY is set (and OPENAI_BASE_URL is empty), else local
TRANSCRIPTION_PROVIDER=auto
WHISPER_MODEL=base                 # tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 on CPU, float16 on GPU
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Storage & limits ---
# STORAGE_DIR=/absolute/path/for/uploads   (default: backend/storage)
MAX_UPLOAD_MB=500
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
AI_RATE_LIMIT_PER_MINUTE=12
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Frontend (only needed when the API is on a different origin) ---
# VITE_API_BASE_URL=https://your-backend.onrender.com
